# Use Node.js 20 base image
FROM node:20-bookworm-slim as builder

# Install build dependencies for native modules (node-pty)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the entire source code
COPY . .

# Delete workspaces we don't need for the web terminal to prevent their
# lifecycle scripts (like generate-notices) from failing the build.
RUN rm -rf packages/vscode-ide-companion packages/devtools packages/sdk packages/a2a-server

# Update root package.json so npm doesn't look for the deleted workspaces
# and rewrite the bundle script to skip building devtools and generate-git-commit-info
RUN node -e "const fs = require('fs'); const pkg = JSON.parse(fs.readFileSync('package.json')); pkg.workspaces = ['packages/cli', 'packages/core', 'packages/test-utils', 'packages/web-terminal']; pkg.scripts.bundle = 'node esbuild.config.js && node scripts/copy_bundle_assets.js'; fs.writeFileSync('package.json', JSON.stringify(pkg, null, 2));"

# Force public registry for @google scope in case a local .npmrc was copied
RUN npm config set @google:registry https://registry.npmjs.org/

# Increase Node.js heap limit for bundling
ENV NODE_OPTIONS="--max-old-space-size=4096"

# Install dependencies (ignoring scripts initially to avoid husky/prepare)
RUN npm install --no-package-lock --registry=https://registry.npmjs.org/ --ignore-scripts

# Rebuild native dependencies manually since we ignored scripts
RUN npm rebuild @lydell/node-pty

# Remove a2a-server from the bundle targets safely
RUN node -e "const fs = require('fs'); let cfg = fs.readFileSync('esbuild.config.js', 'utf8'); cfg = cfg.replace('esbuild.build(a2aServerConfig),', ''); cfg = cfg.replace('const [cliResult, webTerminalResult, a2aResult] = results;', 'const [cliResult, webTerminalResult] = results;'); cfg = cfg.replace('if (a2aResult.status === \\'rejected\\') {', 'if (false) {'); fs.writeFileSync('esbuild.config.js', cfg);"

# Bundle everything using esbuild (this generates bundle/gemini.js and bundle/web-terminal.js)
# This is MUCH faster and uses FAR less memory than tsc.
RUN npm run bundle

# Copy web-terminal public assets into the bundle folder for the final image
RUN cp -r packages/web-terminal/public bundle/public

# Final stage
FROM node:20-bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    curl \
    gnupg \
    tini \
    && rm -rf /var/lib/apt/lists/*

# Install GCS FUSE
RUN echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt gcsfuse-bookworm main" | tee /etc/apt/sources.list.d/gcsfuse.list \
    && curl https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg \
    && apt-get update \
    && apt-get install -y gcsfuse \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy only the bundle and necessary node_modules (for native pty)
COPY --from=builder /app/bundle /app/bundle
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/package.json /app/package.json

# Create mount point for GCS FUSE
RUN mkdir -p /mnt/gcs-workspace

# Set environment variables
ENV NODE_ENV=production
ENV PORT=8080
ENV WORKSPACE_DIR=/mnt/gcs-workspace

# Expose the port
EXPOSE 8080

# Use tini to manage the process
ENTRYPOINT ["/usr/bin/tini", "--"]

# Run the bundled web terminal server
# We use node directly on the bundled file.
CMD ["node", "bundle/web-terminal.js"]
