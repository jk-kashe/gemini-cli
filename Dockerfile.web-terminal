# Use Node.js 20 base image
FROM node:20-bookworm-slim as builder

# Install build dependencies for native modules (node-pty)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the entire source code first. 
# This eliminates "file not found" errors for lifecycle scripts because they are now present.
# The .dockerignore file ensures we don't copy local node_modules or large irrelevant folders.
COPY . .

# Force public registry for @google scope in case a local .npmrc was copied
RUN npm config set @google:registry https://registry.npmjs.org/

# Install ONLY the necessary workspace and its dependencies. 
# This avoids installing the VS Code extension or other heavy packages entirely.
RUN npm install --workspace=@google/gemini-cli-web-terminal --include-workspace-root --no-package-lock --registry=https://registry.npmjs.org/ --ignore-scripts

# Rebuild native dependencies manually since we ignored scripts
RUN npm rebuild @lydell/node-pty

# Build the required packages
RUN npm run build --workspace=@google/gemini-cli-core
RUN npm run build --workspace=@google/gemini-cli-web-terminal

# Final stage
FROM node:20-bookworm-slim

# Install runtime dependencies
# - git: used by gemini-cli tools
# - gcsfuse: for mounting Google Cloud Storage
# - tini: for proper signal handling
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    curl \
    gnupg \
    tini \
    && rm -rf /var/lib/apt/lists/*

# Install GCS FUSE
RUN echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt gcsfuse-bookworm main" | tee /etc/apt/sources.list.d/gcsfuse.list \
    && curl https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg \
    && apt-get update \
    && apt-get install -y gcsfuse \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy built artifacts and node_modules from builder
COPY --from=builder /app /app

# Create mount point for GCS FUSE
RUN mkdir -p /mnt/gcs-workspace

# Set environment variables
ENV NODE_ENV=production
ENV PORT=8080
ENV WORKSPACE_DIR=/mnt/gcs-workspace

# Expose the port
EXPOSE 8080

# Use tini to manage the process
ENTRYPOINT ["/usr/bin/tini", "--"]

# Run the web terminal server
CMD ["npm", "start", "-w", "@google/gemini-cli-web-terminal"]
